_window_session_completion() {
    local cur=${COMP_WORDS[COMP_CWORD]}
    local opts="--help -h"

    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=($(compgen -W "list restore save show $opts" -- "$cur"))
        return 0
    fi

    case "${COMP_WORDS[1]}" in
        restore)
            opts+=" --current --go --place --previous"
            ;;
        save)
            opts+=" --force --verbose"
            ;;
        show)
            opts+=" --current --previous"
            ;;
    esac

    if [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W "$opts" -- "$cur"))
    elif [[ ${COMP_WORDS[1]} == restore || ${COMP_WORDS[1]} == show ]]; then
        _filedir
    fi
}

complete -F _window_session_completion window-session
