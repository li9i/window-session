#!/usr/bin/env python3
"""Record the open X11 windows and relaunch them after a crash or a reboot.

Everything is kept in one file, ~/.local/state/window-session.json, rewritten
in place. It holds two records. "current" is the desktop as it stands, renewed
every time the window list changes. "previous session" is what "current" held
when the desktop session it described came to an end, which after a crash is
the record worth restoring, because by then the live record describes the near
empty desktop you have just logged into.

Beside those two it holds the states stored by hand, each under a name and with
a description if one was given. They stay until deleted, so a desktop stored
today can be put back days and many reboots later.

Two extras are worked out while the programs are still alive, because the
information is gone once they die:

  Terminal windows get the working directory of the shell running in them.
  Several windows share one terminal process, so the shells are paired with
  the windows in creation order. With tabs in play the pairing can slip.

  File manager windows get the folder they show. The folder is not published
  on the window, so it is found through the inotify watch the file manager
  holds on the folder it displays: the watch gives an inode, and a scan of the
  home directory turns that inode into a path. Resolved paths are cached in
  the same file.

Usage:
  window-session save [--force]
      Renew the current record. Without --force, nothing is written unless the
      window list changed.

  window-session list [--names]
      The two records, their age and their size, then the stored states.
      With --names, only the names of the stored states, one to a line.

  window-session store [NAME] [--description TEXT]
      Store the desktop as it stands under NAME. Left out, NAME is made up
      of an adjective and a scientist's surname, as in calm_curie. A name
      already taken is refused.

  window-session delete NAME
      Delete a stored state.

  window-session show [NAME] [--current] [--previous] [--file FILE]
      Print a record in readable form.

  window-session restore [NAME] [--go] [--place] [--current] [--previous]
                         [--file FILE]
      Print what would be relaunched. With --go, launch the programs that are
      missing. With --place, also try to put the new windows back on their
      recorded workspace and geometry.

NAME picks a stored state. With none of NAME, --current and --previous, both
commands take the previous session when the current record belongs to the
session running now, and the current record otherwise. That is the one you want
after a crash. --file reads a copy of the state file kept somewhere else, which
is how a restore is tried out without disturbing the desktop.

What comes back: the programs, how many windows each had, their workspace,
their size, a terminal's directory and a file manager's folder. Not the state
inside them. Browsers and editors restore their own tabs and documents. A
terminal comes back as a fresh shell, so the recorded window titles and the
commands that were running are printed as a reminder.
"""

import argparse
import collections
import contextlib
import fcntl
import glob
import json
import os
import random
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import time

STATE_FILE = os.environ.get(
    "WINDOW_SESSION_FILE", os.path.expanduser("~/.local/state/window-session.json"))

# Where each browser keeps the tabs it has open, and the format of that file.
# Chrome appends to a log of commands; Firefox rewrites a compressed JSON file
# every 15 seconds while it runs.
BROWSER_SESSIONS = {
    "chrome": ("snss", ["~/.config/google-chrome/*/Sessions/Session_*"]),
    "firefox": ("mozlz4", [
        profiles + "/*/sessionstore-backups/recovery.jsonlz4"
        for profiles in ("~/.mozilla/firefox",
                         "~/snap/firefox/common/.mozilla/firefox")]),
}

# How each browser is told to open a window of tabs: the option for a new
# window, and the option for a tab. With no tab option, every URL goes after
# the window option in one command. Firefox opens only the first URL that way,
# so each later one is sent as a command of its own, which lands in the window
# that was opened last.
BROWSER_OPEN = {
    "chrome": ("--new-window", None),
    "firefox": ("--new-window", "--new-tab"),
}

# Where the bash hook in share/window-session/history.bash keeps a journal of
# the commands typed in each shell, named after its process id and start time,
# and the variable that hands a restored shell the commands of its window.
JOURNAL_DIR = os.path.expanduser("~/.local/state/window-session/journals")
HISTORY_ENV = "WINDOW_SESSION_HISTORY"

# Directories searched for an AppImage when the recorded path was a temporary
# mount point that no longer exists.
APPIMAGE_DIRS = ["~/Applications", "~/Downloads", "~/Downloads/programs",
                 "~/Desktop", "~/bin", "~/.local/bin", "~/opt"]

# File managers open a folder given as the first argument.
FILE_MANAGERS = {"caja", "nautilus", "nemo", "pcmanfm", "thunar"}

# How long to wait before looking again for a folder that could not be found.
FOLDER_RETRY_SECONDS = 3600

# Bounds for the scan that turns an inode into a path.
SCAN_MAX_DEPTH = 16
SCAN_SKIP_DIRS = {".cache", ".git", ".npm", ".rustup", "Trash", "__pycache__",
                  "build", "install", "log", "node_modules", "snap"}

# A Firefox session file starts with a magic string and the decompressed size.
MOZLZ4_HEADER_SIZE = 12

# Programs that bring their own windows back, so launch them once and let them
# do the rest.
SELF_RESTORING = {"brave", "chrome", "chromium", "firefox", "google-chrome",
                  "microsoft-edge", "opera", "vivaldi"}

SHELLS = {"bash", "csh", "dash", "fish", "sh", "tcsh", "zsh"}

# Part of the desktop itself. Never launched.
SKIP_EXES = {"marco", "mate-panel", "mate-screensaver", "mate-session"}

# A Chrome session file starts with a magic string and a version, and then
# holds commands, each a size, a kind and a payload. These are the kinds that
# say which tabs are open, in which window, in which order, and on which page.
SNSS_HEADER_SIZE = 8
SNSS_SET_TAB_WINDOW = 0
SNSS_SET_TAB_INDEX = 2
SNSS_UPDATE_NAVIGATION = 6
SNSS_SET_SELECTED_NAVIGATION = 7
SNSS_TAB_CLOSED = 16
SNSS_WINDOW_CLOSED = 17

# A state stored without a name gets one adjective and one scientist's
# surname, joined the way docker names its containers.
NAME_ADJECTIVES = [
    "admiring", "bold", "brave", "calm", "careful", "cheerful", "clever",
    "curious", "daring", "eager", "earnest", "fearless", "focused", "friendly",
    "gentle", "happy", "hopeful", "humble", "jolly", "keen", "kind", "lively",
    "lucky", "merry", "modest", "nimble", "patient", "playful", "proud",
    "quiet", "relaxed", "serene", "sharp", "steady", "sunny", "tender",
    "thoughtful", "tidy", "upbeat", "vigilant", "warm", "wise", "witty",
]
NAME_SURNAMES = [
    "babbage", "bohr", "boole", "curie", "darwin", "dirac", "einstein",
    "euler", "faraday", "fermi", "feynman", "franklin", "gauss", "goodall",
    "hamilton", "hawking", "hopper", "hypatia", "kepler", "lamarr", "leibniz",
    "lovelace", "maxwell", "meitner", "mendel", "newton", "noether", "pascal",
    "pasteur", "planck", "ramanujan", "riemann", "shannon", "tesla", "turing",
    "volta", "wu", "yalow",
]

TAKEN_FORMAT = "%Y-%m-%d %H:%M:%S"

# Window types that are furniture rather than applications.
SKIP_TYPES = {
    "_NET_WM_WINDOW_TYPE_DESKTOP",
    "_NET_WM_WINDOW_TYPE_DOCK",
    "_NET_WM_WINDOW_TYPE_SPLASH",
    "_NET_WM_WINDOW_TYPE_TOOLBAR",
}

# Terminals that take their starting directory on the command line.
TERMINAL_CWD_OPTION = {
    "gnome-terminal": "--working-directory",
    "mate-terminal": "--working-directory",
    "terminator": "--working-directory",
    "tilix": "--working-directory",
    "xfce4-terminal": "--default-working-directory",
}


def annotate_folders(windows, state):
    """Record the folder each file manager window is showing."""
    wanted = [w for w in windows
              if program_name(w) in FILE_MANAGERS and w.get("title")]
    if not wanted:
        return
    watched = {}
    for pid in {w["pid"] for w in wanted if w.get("pid")}:
        watched[pid] = inotify_inodes(pid)

    cache = state.setdefault("folder_cache", {})
    pending = set()
    for window in wanted:
        title = window["title"]
        inodes = watched.get(window.get("pid"), set())
        entry = cache.get(title) or {}
        path = entry.get("path")
        if path and os.path.isdir(path) and inode_of(path) in inodes:
            window["folder"] = path
            continue
        if not path and time.time() - entry.get("checked", 0) < FOLDER_RETRY_SECONDS:
            continue
        pending.add(title)

    if pending:
        all_inodes = set().union(*watched.values()) if watched else set()
        found = resolve_folders(pending, all_inodes)
        for title in pending:
            cache[title] = {"path": found.get(title), "checked": time.time()}
        for window in wanted:
            if window["title"] in found:
                window["folder"] = found[window["title"]]


def annotate_shell_dirs(windows):
    """Record the directory of the shell running in each terminal window."""
    by_pid = {}
    for window in windows:
        if program_name(window) in TERMINAL_CWD_OPTION and window.get("pid"):
            by_pid.setdefault(window["pid"], []).append(window)
    for pid, group in by_pid.items():
        for window, shell in zip(group, shell_children(pid)):
            window["shell_cwd"] = shell["cwd"]
            window["shell_command"] = shell["command"]
            window["shell_history"] = journal_lines(shell["pid"])


def appimage_for(name):
    for directory in APPIMAGE_DIRS:
        pattern = os.path.join(os.path.expanduser(directory), "*.AppImage")
        for path in sorted(glob.glob(pattern)):
            if name.lower() in os.path.basename(path).lower():
                return path
    return None


def browser_commands(name, program, urls):
    """The commands that open the URLs as the tabs of one new window."""
    window_option, tab_option = BROWSER_OPEN[name]
    if tab_option is None:
        return [program + [window_option] + urls]
    return ([program + [window_option, urls[0]]]
            + [program + [tab_option, url] for url in urls[1:]])


def change_key(windows):
    return sorted(
        (
            w.get("wm_class") or "",
            " ".join(w.get("cmdline") or []),
            w.get("folder") or "",
            w.get("shell_cwd") or "",
            str(len(w.get("shell_history") or [])),
            str(w.get("desktop")),
            json.dumps(w.get("geometry"), sort_keys=True),
        )
        for w in windows
    )


def chosen_record(state, args):
    """The stored state named on the command line, or else pick_record's."""
    if args.name:
        return state["stored"][args.name]
    return pick_record(state, wanted_record(args))


def cmd_delete(args):
    with state_lock():
        state = load_state(None)
        if unknown_name(state, args.name):
            return 1
        del state["stored"][args.name]
        save_state(state)
    print("deleted %s" % args.name)
    return 0


def cmd_list(args):
    state = load_state(None)
    if args.names:
        for name in state.get("stored", {}):
            print(name)
        return 0
    default = pick_record(state, None)
    for name in ("current", "previous session"):
        record = state.get(record_key(name))
        if not record:
            print("%-17s nothing recorded" % name)
            continue
        print("%-17s %s  %2d windows%s" % (
            name, record.get("taken", "?"), len(record.get("windows", [])),
            "  <- used by restore" if record is default else ""))

    stored = state.get("stored", {})
    if stored:
        print("\nstored")
    width = max((len(name) for name in stored), default=0)
    for name, record in stored.items():
        print(("%-*s  %s  %2d windows  %s" % (
            width, name, record["taken"], len(record["windows"]),
            record.get("description") or "")).rstrip())
    return 0


def cmd_restore(args):
    state = load_state(args.file)
    if unknown_name(state, args.name):
        return 1
    record = chosen_record(state, args)
    if not record:
        print("nothing recorded yet in %s" % (args.file or STATE_FILE))
        return 1
    windows = record.get("windows", [])
    print("%s record, %d windows, taken %s\n" % (
        record.get("name", "?"), len(windows), record.get("taken", "?")))

    open_windows = read_windows() or []
    open_places, open_unplaced = open_window_counts(open_windows, state)
    live_tabs = open_tabs(open_windows)
    recorded_tabs = record.get("tabs", {})
    started = 0
    for group in group_by_process(windows):
        wm_class = group["wm_class"] or ""
        program = resolve_program(group)
        if not program:
            print("%s: no runnable command recorded" % wm_class)
            for window in group["windows"]:
                print_window(window)
            continue
        name = os.path.basename(program[0])
        if name in SKIP_EXES:
            continue

        if name in recorded_tabs:
            new_windows = missing_tabs(recorded_tabs[name],
                                       live_tabs.get(name, []))
            print("%s: %d tab(s) recorded, %d not open, open them in %d new "
                  "window(s)" % (
                      wm_class, sum(len(w) for w in recorded_tabs[name]),
                      sum(len(w) for w in new_windows), len(new_windows)))
            print("  %s" % " ".join(program))
            for urls in new_windows:
                print("  - window")
                for url in urls:
                    print("    %s" % url)
            if args.go:
                for urls in new_windows:
                    for command in browser_commands(name, program, urls):
                        if not spawn(command, None):
                            print("  failed to start %s" % " ".join(command))
                    started += 1
            continue

        self_restoring = name.lower() in SELF_RESTORING
        targets = group["windows"][:1] if self_restoring else group["windows"]
        to_start = missing_windows(targets, wm_class, open_places,
                                   open_unplaced)
        already = len(targets) - len(to_start)
        print("%s: %d window(s) recorded, %d already open, start %d%s" % (
            wm_class, len(group["windows"]), already, len(to_start),
            "  (restores its own windows and tabs)" if self_restoring else ""))
        print("  %s" % " ".join(program))
        for window in group["windows"]:
            print_window(window)

        if args.go:
            for window in to_start:
                command = program + launch_extras(window)
                cwd = window.get("shell_cwd") or group["cwd"]
                if not (cwd and os.path.isdir(cwd)):
                    cwd = None
                if spawn(command, cwd, history_env(window)):
                    started += 1
                else:
                    print("  failed to start %s" % " ".join(command))

    if not args.go:
        print("dry run. add --go to launch, and --place to also restore "
              "workspaces and window sizes.")
        return 0
    print("started %d window(s)" % started)
    if args.place and started:
        print("waiting for the windows to appear, then placing them")
        time.sleep(8)
        place_windows(windows)
    return 0


def cmd_save(args):
    prune_journals()
    windows = read_windows()
    if windows is None:
        return 0  # no X display reachable, stay quiet
    if not windows:
        return 0  # never record an empty desktop over a good record
    with state_lock():
        state = load_state(None)
        record = new_record(windows, state)

        started = session_start_time()
        current = state.get("current")
        if current and started and current.get("session_start") != started:
            # The session that record described has ended. Keep it, because
            # after a crash it is the one worth restoring.
            state["previous_session"] = current
            current = None
        if current and not args.force:
            if change_key(current.get("windows", [])) == change_key(windows):
                return 0

        record["session_start"] = started
        state["current"] = record
        save_state(state)
    if args.verbose:
        print("recorded %d windows in %s" % (len(windows), STATE_FILE))
    return 0


def cmd_show(args):
    state = load_state(args.file)
    if unknown_name(state, args.name):
        return 1
    record = chosen_record(state, args)
    if not record:
        print("nothing recorded yet in %s" % (args.file or STATE_FILE))
        return 1
    print("%s record, taken %s" % (
        record.get("name", "?"), record.get("taken", "?")))
    if record.get("description"):
        print(record["description"])
    print()
    for window in record.get("windows", []):
        desktop = window.get("desktop")
        geometry = window.get("geometry") or {}
        print("workspace %-4s %-22s %s" % (
            "all" if desktop == -1 else ("?" if desktop is None else desktop + 1),
            window.get("wm_class") or "?",
            window.get("title") or "(no title)"))
        print("               %sx%s at %s,%s   %s" % (
            geometry.get("width", "?"), geometry.get("height", "?"),
            geometry.get("x", "?"), geometry.get("y", "?"),
            " ".join(window.get("cmdline") or []) or "(command line unknown)"))
        where = window.get("folder") or window.get("shell_cwd")
        if where:
            print("               in %s" % where)
        if window.get("shell_command"):
            print("               was running %s" % window["shell_command"])
        if window.get("shell_history"):
            print("               with %d commands of its own"
                  % len(window["shell_history"]))
    return 0


def cmd_store(args):
    with state_lock():
        state = load_state(None)
        stored = state.setdefault("stored", {})
        name = args.name or made_up_name(stored)
        if name in stored:
            print("%s is taken. Delete it first, or store under another name."
                  % name)
            return 1
        record = new_record(read_windows(), state)
        record["description"] = args.description
        record["tabs"] = open_tabs(record["windows"])
        stored[name] = record
        save_state(state)
    print("stored %d windows as %s" % (len(record["windows"]), name))
    return 0


def group_by_process(windows):
    groups = {}
    order = []
    for window in windows:
        key = (window.get("wm_class") or "",
               tuple(window.get("cmdline") or []),
               window.get("cwd") or "")
        if key not in groups:
            groups[key] = {
                "wm_class": window.get("wm_class"),
                "cmdline": list(window.get("cmdline") or []),
                "cwd": window.get("cwd"),
                "exe": window.get("exe"),
                "windows": [],
            }
            order.append(key)
        groups[key]["windows"].append(window)
    return [groups[key] for key in order]


def history_env(window):
    """The environment that hands a restored shell the commands of its window.

    The commands go into a file of their own, which the bash hook reads at the
    first prompt of the new shell and then deletes.
    """
    if not window.get("shell_history"):
        return None
    os.makedirs(JOURNAL_DIR, exist_ok=True)
    handle, path = tempfile.mkstemp(prefix="restore-", dir=JOURNAL_DIR)
    with os.fdopen(handle, "w") as out:
        out.write("\n".join(window["shell_history"]) + "\n")
    return dict(os.environ, **{HISTORY_ENV: path})


def inode_of(path):
    try:
        return os.stat(path).st_ino
    except OSError:
        return None


def inotify_inodes(pid):
    """Inodes the process is watching, one per open folder among others."""
    inodes = set()
    for path in glob.glob("/proc/%d/fdinfo/*" % pid):
        try:
            with open(path) as handle:
                text = handle.read()
        except OSError:
            continue
        for match in re.finditer(r"^inotify wd:\S+ ino:(\S+)", text, re.M):
            inodes.add(int(match.group(1), 16))
    return inodes


def journal_lines(pid):
    """The commands typed in a shell, from the journal the bash hook keeps."""
    path = os.path.join(JOURNAL_DIR, "%d-%d" % (pid, process_starttime(pid)))
    if not os.path.exists(path):
        return []
    with open(path) as handle:
        return handle.read().splitlines()


def launch_extras(window):
    """Command line arguments that put a window back where it was."""
    name = program_name(window)
    if name in FILE_MANAGERS and window.get("folder"):
        return [window["folder"]]
    option = TERMINAL_CWD_OPTION.get(name)
    if option and window.get("shell_cwd"):
        return ["%s=%s" % (option, window["shell_cwd"])]
    return []


def load_state(path):
    try:
        with open(path or STATE_FILE) as handle:
            state = json.load(handle)
    except (OSError, ValueError):
        return {}
    for name in ("current", "previous session"):
        record = state.get(record_key(name))
        if record:
            record["name"] = name
    for name, record in state.get("stored", {}).items():
        record["name"] = name
    return state


def lz4_block(data):
    """Decompress one LZ4 block, the format inside a Firefox session file."""
    out = bytearray()
    i = 0
    while i < len(data):
        token = data[i]
        length, i = lz4_length(data, i + 1, token >> 4)
        out += data[i:i + length]
        i += length
        if i >= len(data):
            break
        offset = data[i] | data[i + 1] << 8
        length, i = lz4_length(data, i + 2, token & 15)
        length += 4
        start = len(out) - offset
        if offset >= length:
            out += out[start:start + length]
        else:
            for k in range(length):
                out.append(out[start + k])
    return bytes(out)


def lz4_length(data, i, length):
    """A length from an LZ4 token, extended by the bytes that follow it."""
    if length == 15:
        while True:
            byte = data[i]
            i += 1
            length += byte
            if byte != 255:
                break
    return length, i


def made_up_name(taken):
    """An adjective and a surname, picked again until the pair is free."""
    while True:
        name = "%s_%s" % (random.choice(NAME_ADJECTIVES),
                          random.choice(NAME_SURNAMES))
        if name not in taken:
            return name


def main():
    os.environ.setdefault("DISPLAY", ":0")
    os.environ.setdefault("XAUTHORITY", os.path.expanduser("~/.Xauthority"))

    parser = argparse.ArgumentParser(
        description="Record and relaunch the open desktop windows.")
    subparsers = parser.add_subparsers(dest="command")

    save = subparsers.add_parser("save", help="renew the current record")
    save.add_argument("--force", action="store_true", help="write even if unchanged")
    save.add_argument("--verbose", action="store_true")
    save.set_defaults(func=cmd_save)

    listing = subparsers.add_parser(
        "list", help="the two records and the stored states")
    listing.add_argument("--names", action="store_true",
                         help="only the names of the stored states")
    listing.set_defaults(func=cmd_list)

    store = subparsers.add_parser("store",
                                  help="store the desktop as it stands")
    store.add_argument("name", nargs="?",
                       help="made up, as in calm_curie, when left out")
    store.add_argument("-d", "--description", help="what the state is for")
    store.set_defaults(func=cmd_store)

    delete = subparsers.add_parser("delete", help="delete a stored state")
    delete.add_argument("name")
    delete.set_defaults(func=cmd_delete)

    for name, help_text, function in (("show", "print a record", cmd_show),
                                      ("restore", "relaunch a record", cmd_restore)):
        command = subparsers.add_parser(name, help=help_text)
        command.add_argument("name", nargs="?", help="a stored state")
        command.add_argument("--file", help="read another state file")
        command.add_argument("--current", action="store_true",
                             help="the desktop as last seen")
        command.add_argument("--previous", action="store_true",
                             help="the session that ended")
        command.set_defaults(func=function)
        if name == "restore":
            command.add_argument("--go", action="store_true", help="actually launch")
            command.add_argument("--place", action="store_true",
                                 help="also restore workspace and geometry")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return 0
    return args.func(args) or 0


def missing_tabs(recorded, live):
    """The recorded tabs that are not open now, kept in their windows."""
    open_urls = {url for window in live for url in window}
    windows = [[url for url in window if url not in open_urls]
               for window in recorded]
    return [window for window in windows if window]


def missing_windows(windows, wm_class, open_places, open_unplaced):
    """The recorded windows that the desktop lacks.

    A window with a place, the folder of a terminal or of a file manager, is
    there when a window of its class is open on that place. A window with no
    place is matched by count within its class. Each open window is matched
    once.
    """
    missing = []
    for window in windows:
        place = window_place(window)
        key = (wm_class, place)
        if place is not None and open_places[key]:
            open_places[key] -= 1
        elif place is None and open_unplaced[wm_class]:
            open_unplaced[wm_class] -= 1
        else:
            missing.append(window)
    return missing


def move_window(wid, x, y):
    """Move a window so that it ends up where it was recorded.

    A move is measured against the window frame, which the window manager adds
    back on, so ask once, see where the window landed, and correct the offset.
    """
    run(["xdotool", "windowmove", wid, str(x), str(y)])
    landed = window_geometry(wid)
    if not landed:
        return
    offset_x, offset_y = landed["x"] - x, landed["y"] - y
    if offset_x or offset_y:
        run(["xdotool", "windowmove", wid, str(x - offset_x), str(y - offset_y)])


def new_record(windows, state):
    """A record of the windows, with what only the live programs can tell."""
    annotate_shell_dirs(windows)
    annotate_folders(windows, state)
    return {
        "taken": time.strftime(TAKEN_FORMAT),
        "host": os.uname().nodename,
        "windows": windows,
    }


def newest_file(patterns):
    paths = [path for pattern in patterns
             for path in glob.glob(os.path.expanduser(pattern))]
    return max(paths, key=os.path.getmtime, default=None)


def open_tabs(windows):
    """The tabs open in each browser that has a window among the windows."""
    readers = {"snss": read_snss, "mozlz4": read_mozlz4}
    running = {program_name(window) for window in windows}
    tabs = {}
    for name, (kind, patterns) in BROWSER_SESSIONS.items():
        path = newest_file(patterns)
        if name in running and path:
            tabs[name] = readers[kind](path)
    return tabs


def open_window_counts(windows, state):
    """Open windows counted by class and place, and by class for the rest."""
    annotate_shell_dirs(windows)
    annotate_folders(windows, state)
    places = collections.Counter()
    unplaced = collections.Counter()
    for window in windows:
        place = window_place(window)
        if place is None:
            unplaced[window.get("wm_class") or ""] += 1
        else:
            places[(window.get("wm_class") or "", place)] += 1
    return places, unplaced


def pick_record(state, wanted):
    """The record to work from.

    Asked for one by name, that one. Otherwise the previous session, as long
    as the current record belongs to the session running now, which is the
    case after a crash.
    """
    current = state.get("current")
    previous = state.get("previous_session")
    if wanted:
        return current if wanted == "current" else previous
    started = session_start_time()
    if current and started and current.get("session_start") == started:
        return previous or current
    return current or previous


def place_windows(windows):
    used = set()
    current = read_client_list() or []
    for window in windows:
        wm_class = window.get("wm_class")
        geometry = window.get("geometry") or {}
        if not wm_class or not geometry:
            continue
        target = None
        for wid in current:
            if wid not in used and window_class(wid) == wm_class:
                target = wid
                break
        if not target:
            continue
        used.add(target)
        desktop = window.get("desktop")
        if desktop is not None and desktop >= 0:
            run(["xdotool", "set_desktop_for_window", target, str(desktop)])
        run(["xdotool", "windowsize", target,
             str(geometry["width"]), str(geometry["height"])])
        move_window(target, geometry["x"], geometry["y"])


def print_window(window):
    print("  - %s" % (window.get("title") or "(no title)"))
    where = window.get("folder") or window.get("shell_cwd")
    if where:
        print("    in %s" % where)
    if window.get("shell_command"):
        print("    was running %s" % window["shell_command"])
    if window.get("shell_history"):
        print("    with %d commands of its own" % len(window["shell_history"]))


def process_info(pid):
    info = {"cmdline": None, "cwd": None, "exe": None}
    if not pid:
        return info
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as handle:
            parts = [p.decode("utf-8", "replace")
                     for p in handle.read().split(b"\0") if p]
        info["cmdline"] = parts or None
    except OSError:
        pass
    for key in ("cwd", "exe"):
        try:
            info[key] = os.readlink("/proc/%d/%s" % (pid, key))
        except OSError:
            pass
    return info


def process_starttime(pid):
    """Process start time in clock ticks since boot, so newer means larger."""
    try:
        with open("/proc/%d/stat" % pid) as handle:
            fields = handle.read().rpartition(")")[2].split()
        return int(fields[19])
    except (OSError, IndexError, ValueError):
        return 0


def program_name(window):
    cmdline = window.get("cmdline") or []
    if not cmdline:
        return ""
    name = os.path.basename(cmdline[0])
    if name.startswith("python") and len(cmdline) > 1:
        name = os.path.basename(cmdline[1])
    return name


def prune_journals():
    """Delete the journals of shells that are no longer running.

    A journal is named after the process id and the start time of its shell,
    so a process id that came back for another process does not keep it. The
    files that hand a restored shell its commands have other names and stay.
    """
    for path in glob.glob(os.path.join(JOURNAL_DIR, "*-*")):
        pid, _, start = os.path.basename(path).partition("-")
        if not (pid.isdigit() and start.isdigit()):
            continue
        if process_starttime(int(pid)) != int(start):
            os.remove(path)


def read_client_list():
    out = run(["xprop", "-root", "_NET_CLIENT_LIST"])
    if out is None or "not found" in out:
        return None
    return re.findall(r"0x[0-9a-fA-F]+", out)


def read_mozlz4(path):
    """The tabs of each open window in a Firefox session file."""
    with open(path, "rb") as handle:
        data = handle.read()
    session = json.loads(lz4_block(data[MOZLZ4_HEADER_SIZE:]))
    return [[tab["entries"][tab["index"] - 1]["url"]
             for tab in window["tabs"] if tab["entries"]]
            for window in session["windows"]]


def read_snss(path):
    """The tabs of each open window in a Chrome session file, in tab order.

    The file is a log that Chrome appends to as tabs open, move, navigate and
    close, so the open windows are what is left after replaying all of it.
    Chrome may be halfway through writing the last command, which is skipped.
    """
    with open(path, "rb") as handle:
        data = handle.read()
    tabs = collections.defaultdict(lambda: {"navigations": {}})
    closed_windows = set()
    offset = SNSS_HEADER_SIZE
    while offset + 2 < len(data):
        size = struct.unpack_from("<H", data, offset)[0]
        if offset + 2 + size > len(data):
            break
        kind = data[offset + 2]
        body = data[offset + 3:offset + 2 + size]
        offset += 2 + size
        if kind == SNSS_SET_TAB_WINDOW:
            window, tab = struct.unpack_from("<ii", body)
            tabs[tab]["window"] = window
        elif kind == SNSS_SET_TAB_INDEX:
            tab, index = struct.unpack_from("<ii", body)
            tabs[tab]["index"] = index
        elif kind == SNSS_UPDATE_NAVIGATION:
            tab, index, length = struct.unpack_from("<iii", body, 4)
            tabs[tab]["navigations"][index] = body[16:16 + length].decode(
                "utf-8", "replace")
        elif kind == SNSS_SET_SELECTED_NAVIGATION:
            tab, index = struct.unpack_from("<ii", body)
            tabs[tab]["selected"] = index
        elif kind == SNSS_TAB_CLOSED:
            tabs.pop(struct.unpack_from("<i", body)[0], None)
        elif kind == SNSS_WINDOW_CLOSED:
            closed_windows.add(struct.unpack_from("<i", body)[0])

    windows = {}
    for tab in tabs.values():
        navigations = tab["navigations"]
        if (not navigations or "window" not in tab
                or tab["window"] in closed_windows):
            continue
        url = navigations.get(tab.get("selected"),
                              navigations[max(navigations)])
        windows.setdefault(tab["window"], []).append((tab.get("index", 0), url))
    return [[url for _, url in sorted(window)] for window in windows.values()]


def read_windows():
    ids = read_client_list()
    if ids is None:
        return None
    windows = []
    for wid in ids:
        window = window_info(wid)
        if window:
            windows.append(window)
    return windows


def record_key(name):
    return name.replace(" ", "_")


def resolve_folders(titles, inodes):
    """Find the folder behind each window title by matching watched inodes."""
    found = {}
    home = os.path.expanduser("~")
    if titles and os.path.basename(home) in titles and inode_of(home) in inodes:
        found[os.path.basename(home)] = home
    for root, dirs, _ in os.walk(home):
        if root.count(os.sep) - home.count(os.sep) >= SCAN_MAX_DEPTH:
            dirs[:] = []
            continue
        dirs[:] = [d for d in dirs if d not in SCAN_SKIP_DIRS]
        for name in dirs:
            if name not in titles or name in found:
                continue
            path = os.path.join(root, name)
            if not os.path.islink(path) and inode_of(path) in inodes:
                found[name] = path
        if len(found) == len(titles):
            break
    return found


def resolve_program(group):
    """Turn a recorded command line into something runnable today.

    Snap paths carry a revision number and AppImages run from a temporary
    mount point, so both go stale. Fall back to the name on PATH, then to an
    AppImage on disk.
    """
    cmdline = group.get("cmdline") or []
    if not cmdline:
        return None
    first = cmdline[0]
    stale = first.startswith("/tmp/.mount_") or first.startswith("/snap/")
    if not stale and (os.path.isabs(first) and os.path.exists(first)):
        return list(cmdline)
    name = os.path.basename(first)
    found = shutil.which(name)
    if found:
        return [found] + list(cmdline[1:])
    for candidate in (name, group.get("wm_class") or ""):
        if candidate:
            appimage = appimage_for(candidate)
            if appimage:
                return [appimage] + list(cmdline[1:])
    return None


def run(cmd):
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    return result.stdout


def save_state(state):
    """Write the state file whole, so a crash cannot leave half a record."""
    records = [state.get("current"), state.get("previous_session")]
    records += state.get("stored", {}).values()
    for record in records:
        if record:
            record.pop("name", None)
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    temporary = STATE_FILE + ".new"
    with open(temporary, "w") as handle:
        json.dump(state, handle, indent=2)
    os.replace(temporary, STATE_FILE)


def session_start_time():
    """When the desktop session started, or None when that cannot be told."""
    for name in ("mate-session", "marco"):
        out = run(["pgrep", "-u", str(os.getuid()), "-x", name])
        if not out:
            continue
        for pid in out.split():
            try:
                return os.stat("/proc/%s" % pid).st_mtime
            except OSError:
                continue
    return None


def shell_children(pid):
    """Shells running under a terminal process, oldest first.

    The command reported for each shell is its deepest descendant, which is
    what the operator was actually looking at.
    """
    children = {}
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            with open("/proc/%s/stat" % entry) as handle:
                fields = handle.read().rpartition(")")[2].split()
            parent = int(fields[1])
        except (OSError, IndexError, ValueError):
            continue
        children.setdefault(parent, []).append(int(entry))

    shells = []
    for child in children.get(pid, []):
        info = process_info(child)
        cmdline = info["cmdline"] or []
        if not cmdline or os.path.basename(cmdline[0]) not in SHELLS:
            continue
        deepest, current = cmdline, child
        while children.get(current):
            current = children[current][-1]
            found = process_info(current)["cmdline"]
            if found:
                deepest = found
        shells.append({
            "pid": child,
            "cwd": info["cwd"],
            "command": " ".join(deepest),
        })
    return sorted(shells, key=lambda s: process_starttime(s["pid"]))


def spawn(cmdline, cwd, env=None):
    try:
        with open(os.devnull, "wb") as sink:
            subprocess.Popen(cmdline, cwd=cwd, stdout=sink, stderr=sink,
                             stdin=subprocess.DEVNULL, start_new_session=True,
                             env=env)
    except OSError:
        return False
    time.sleep(1.5)
    return True


@contextlib.contextmanager
def state_lock():
    """Let one command at a time read, change and write the state file.

    Without it, a timer save that read the file before a store wrote it would
    write its own copy over the stored state, and two writers would share the
    one temporary file.
    """
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    with open(STATE_FILE + ".lock", "w") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def unknown_name(state, name):
    """Say so when a name is given and no state is stored under it."""
    if name and name not in state.get("stored", {}):
        print("no state is stored as %s. window-session list shows them all."
              % name)
        return True
    return False


def wanted_record(args):
    if args.current:
        return "current"
    if args.previous:
        return "previous session"
    return None


def window_class(wid):
    out = run(["xprop", "-id", wid, "WM_CLASS"])
    if not out:
        return None
    names = re.findall(r'"([^"]*)"', out)
    return names[-1] if names else None


def window_geometry(wid):
    out = run(["xdotool", "getwindowgeometry", "--shell", wid])
    if not out:
        return None
    values = {}
    for line in out.splitlines():
        key, _, value = line.partition("=")
        if value.strip().lstrip("-").isdigit():
            values[key.strip().lower()] = int(value)
    if not {"x", "y", "width", "height"} <= set(values):
        return None
    return {k: values[k] for k in ("x", "y", "width", "height")}


def window_info(wid):
    out = run(["xprop", "-id", wid, "_NET_WM_WINDOW_TYPE", "_NET_WM_PID",
               "_NET_WM_DESKTOP", "WM_CLASS", "_NET_WM_NAME", "WM_NAME"])
    if not out:
        return None

    props = {}
    for line in out.splitlines():
        name = line.partition("(")[0].strip()
        props[name] = line.split("=", 1)[1].strip() if "=" in line else ""

    window_type = props.get("_NET_WM_WINDOW_TYPE", "")
    if any(skip in window_type for skip in SKIP_TYPES):
        return None

    pid = None
    match = re.search(r"\d+", props.get("_NET_WM_PID", ""))
    if match:
        pid = int(match.group())

    desktop = None
    match = re.search(r"0x[0-9a-fA-F]+|\d+", props.get("_NET_WM_DESKTOP", ""))
    if match:
        value = int(match.group(), 0)
        desktop = -1 if value >= 0xFFFFFFFF else value

    names = re.findall(r'"([^"]*)"', props.get("WM_CLASS", ""))
    title = None
    for key in ("_NET_WM_NAME", "WM_NAME"):
        found = re.findall(r'"(.*)"', props.get(key, ""))
        if found:
            title = found[0]
            break

    window = {
        "id": wid,
        "title": title,
        "wm_class": names[-1] if names else None,
        "desktop": desktop,
        "type": window_type,
        "pid": pid,
        "geometry": window_geometry(wid),
    }
    window.update(process_info(pid))
    return window


def window_place(window):
    """The folder a file manager shows, or the one a terminal's shell is in."""
    return window.get("folder") or window.get("shell_cwd")


if __name__ == "__main__":
    sys.exit(main())
